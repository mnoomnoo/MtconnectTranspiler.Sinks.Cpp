{{~ code_name = source.name | to_code_safe | string.remove "." ~}}
// Generated by MtconnectTranspiler.Sinks.Cpp {{ version }}
// Namespace aggregation header for {{ source.normative_name }}
// See https://model.mtconnect.org/#Package__{{ source.reference_id }}
#pragma once

// Sub-namespaces
{{~ for item in source.packages ~}}
{{~ item_code_name = item.name | to_code_safe | string.remove "." ~}}
#include "mtconnect/Packages/{{ item.filename }}"
{{~ end ~}}

// Classes
{{~ for item in source.classes ~}}
{{~ item_code_name = item.name | to_code_safe | string.remove "." ~}}
#include "mtconnect/Classes/{{ item.filename }}"
{{~ end ~}}

// Enums
{{~ for item in source.enums ~}}
{{~ item_code_name = item.name | to_code_safe | string.remove "." ~}}
#include "mtconnect/Enums/{{ item.filename }}"
{{~ end ~}}

{{~ # Build namespace tokens ~}}
{{~ ns_parts = source.namespace | string.replace "::" "." | string.split "." ~}}
{{~ for ns in ns_parts ~}}
namespace {{ ns | to_keyword_safe }} {
{{~ end ~}}

/**
 * @brief Namespace for {{ source.normative_name }}
 * @details {{ include 'CppDocComment.scriban' source?.summary }}
 * @see https://model.mtconnect.org/#Package__{{ source.reference_id }}
 */
namespace {{ code_name | to_keyword_safe }} {
    static constexpr std::string_view REFERENCE_ID = "{{ source.reference_id }}";
    static constexpr std::string_view NAME         = "{{ source.normative_name }}";
} // namespace {{ code_name | to_keyword_safe }}

{{~ for ns in ns_parts ~}}
} // namespace {{ ns | to_keyword_safe }}
{{~ end ~}}

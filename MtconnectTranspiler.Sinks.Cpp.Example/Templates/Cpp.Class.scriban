{{~ code_name = source.name | to_code_safe | string.remove "."
has_generalization = source.generalization != null && source.generalization != ""
~}}
// Generated by MtconnectTranspiler.Sinks.Cpp {{ version }}
// See https://model.mtconnect.org/#Structure__{{ source.reference_id }} for more information.
#pragma once
#include <string>
#include <string_view>
#include <optional>
#include <vector>
#include <cstdint>
{{~ if has_generalization ~}}
{{~ gen_ns = source.generalization_id | get_type_namespace | to_code_safe ~}}
{{~ gen_name = source.generalization | to_pascal_case | to_code_safe | string.remove "." ~}}
{{~ if gen_ns ~}}
#include "mtconnect/Classes/{{ gen_name }}.hpp"
{{~ end ~}}
{{~ end ~}}

{{~ # Build namespace tokens ~}}
{{~ ns_parts = source.namespace | string.replace "::" "." | string.split "." ~}}
{{~ for ns in ns_parts ~}}
namespace {{ ns | to_keyword_safe }} {
{{~ end ~}}

/**
 * @brief {{ code_name }}
 * @details {{ include 'CppDocComment.scriban' source?.summary }}
 * @see https://model.mtconnect.org/#Structure__{{ source.reference_id }}
{{ include 'CppVersionRemarks.scriban' source }} */
struct {{ code_name }}{{~ if has_generalization ~}} : public {{ source.generalization | to_code_safe | string.remove "." }}{{~ end ~}} {
    // --- Metadata ---
    static constexpr std::string_view REFERENCE_ID       = "{{ source.reference_id }}";
    static constexpr std::string_view NAME               = "{{ source.normative_name }}";
    static constexpr std::string_view NORMATIVE_VERSION  = "{{ source.normative_version }}";
    static constexpr std::string_view DEPRECATED_VERSION = "{{ source.deprecated_version }}";
    static constexpr std::string_view HELP_URL           = "https://model.mtconnect.org/#Structure__{{ source.reference_id }}";

    // --- Properties ---
    {{~ for item in source.properties ~}}
    {{~ item_code_name = item.name | to_code_safe | string.remove "." ~}}
    {{~ prop_type = item.type | to_code_safe | string.remove "." ~}}
    {{~ if item.multiplicity != "" && item.multiplicity | string.starts_with "0" ~}}
    std::optional<{{ prop_type }}> {{ item_code_name | to_keyword_safe }};{{~ if item.summary ~}} ///< {{ include 'CppDocComment.scriban' item?.summary }}{{~ end ~}}
    {{~ else ~}}
    {{ prop_type }} {{ item_code_name | to_keyword_safe }}{};{{~ if item.summary ~}} ///< {{ include 'CppDocComment.scriban' item?.summary }}{{~ end ~}}
    {{~ end ~}}
    {{~ end ~}}

    // --- Constraints ---
    {{~ if source.constraints.size > 0 ~}}
    {{~ for constraint in source.constraints ~}}
    // Rule: {{ constraint.name }} ({{ constraint.source_language }})
    // {{ constraint.raw_script }}
    {{~ end ~}}
    {{~ end ~}}
};

{{~ for ns in ns_parts ~}}
} // namespace {{ ns | to_keyword_safe }}
{{~ end ~}}

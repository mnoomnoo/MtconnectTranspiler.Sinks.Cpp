// Generated by MtconnectTranspiler.Sinks.Cpp {{ version }}
// MTConnect Agent Client Example
//
// Demonstrates the three core MTConnect protocol operations:
//   1. Probe     — GET /probe           — retrieve device structure
//   2. Sample    — GET /sample?from=&count= — snapshot of current observations
//   3. Streaming — GET /sample?interval=&heartbeat= — continuous chunked observations
//
// Networking: Boost.Beast + Boost.Asio (HTTP/1.1, synchronous and async)
// Types:      mtconnect C++ library generated by MtconnectTranspiler.Sinks.Cpp
//
// Build requirements:
//   - Boost 1.81+ (beast, asio, system)
//   - C++17 compiler
//
// CMake example:
//   find_package(Boost 1.81 REQUIRED COMPONENTS system)
//   add_executable(mtconnect_example mtconnect_example_client.cpp)
//   target_link_libraries(mtconnect_example PRIVATE mtconnect_cpp Boost::system)
//   target_compile_features(mtconnect_example PRIVATE cxx_std_17)


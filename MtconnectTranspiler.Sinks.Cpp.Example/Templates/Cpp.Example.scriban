// ---------------------------------------------------------------------------
// build_query()
//
// Builds a URL query string from a list of (QueryParameterEnum, value) pairs.
// QueryParameterEnum::to_string() returns the canonical lowercase MTConnect
// parameter name as defined by the standard:
//   INTERVAL  -> "interval"
//   HEARTBEAT -> "heartbeat"
//   FROM      -> "from"
//   COUNT     -> "count"
//   DEVICE    -> "device"
//   etc.
// ---------------------------------------------------------------------------
inline std::string build_query(
    std::initializer_list<std::pair<QueryParameterEnum, std::string>> params)
{
    std::string result;
    bool first = true;
    for (auto const& [key, value] : params) {
        result += first ? "?" : "&";
        result += std::string(to_string(key));
        result += "=";
        result += value;
        first = false;
    }
    return result;
}

// ---------------------------------------------------------------------------
// http_get()
//
// Synchronous Boost.Beast HTTP/1.1 GET.  Returns the response body as a
// std::string or throws beast::system_error on failure.
// ---------------------------------------------------------------------------
inline std::string http_get(
    net::io_context& ioc,
    std::string_view host,
    std::string_view port,
    std::string_view target)
{
    beast::error_code ec;

    tcp::resolver resolver{ioc};
    beast::tcp_stream stream{ioc};

    auto const endpoints = resolver.resolve(host, port, ec);
    if (ec) throw beast::system_error{ec};

    stream.connect(endpoints, ec);
    if (ec) throw beast::system_error{ec};

    http::request<http::empty_body> req{http::verb::get, target, 11};
    req.set(http::field::host, host);
    req.set(http::field::user_agent, BOOST_BEAST_VERSION_STRING);
    req.set(http::field::accept, "application/xml");

    http::write(stream, req, ec);
    if (ec) throw beast::system_error{ec};

    beast::flat_buffer buf;
    http::response<http::string_body> res;
    http::read(stream, buf, res, ec);
    if (ec) throw beast::system_error{ec};

    stream.socket().shutdown(tcp::socket::shutdown_both, ec);
    return res.body();
}

// ---------------------------------------------------------------------------
// probe()
//
// MTConnect Probe operation — GET /probe
//
// Returns an MTConnectDevices Response Document describing the static
// structure (Devices, Components, DataItems) of the agent.
//
// Types demonstrated:
//   MTConnectDevicesClass  — root of the probe response
//   HeaderClass            — agent metadata (bufferSize, version, sender, …)
//   DeviceClass            — one device and its static constexpr metadata
//   DataItemClass          — individual data item descriptor
//   CategoryEnum           — SAMPLE | EVENT | CONDITION classification
//   RepresentationEnum     — how the observation value is encoded
//   UnitEnum               — engineering unit of the data item
//   CategoryEnumMeta       — normative version metadata struct
// ---------------------------------------------------------------------------
void probe(net::io_context& ioc, std::string_view host, std::string_view port)
{
    std::cout << "\n=== PROBE ===\n";
    std::cout << "  GET /probe\n";

    std::string body;
    try {
        body = http_get(ioc, host, port, "/probe");
    } catch (std::exception const& ex) {
        std::cerr << "  probe(): " << ex.what() << "\n";
        return;
    }

    // In a real integration the XML body would be parsed into these structs.
    // Here we illustrate the type shapes and static constexpr metadata.

    // --- Response document root ---
    MTConnectDevicesClass probeResponse;
    // probeResponse.HasHeader    — HeaderClass
    // probeResponse.HasDevice    — DeviceClass

    // --- Header fields ---
    HeaderClass& hdr = probeResponse.HasHeader;
    hdr.Sender     = std::string(host);
    hdr.Version    = std::string(HeaderClass::NORMATIVE_VERSION);
    hdr.BufferSize = 131072;

    std::cout << "  HeaderClass::NAME             = " << HeaderClass::NAME             << "\n";
    std::cout << "  HeaderClass::NORMATIVE_VERSION = " << HeaderClass::NORMATIVE_VERSION << "\n";
    std::cout << "  header.Sender                 = " << hdr.Sender                   << "\n";
    std::cout << "  header.BufferSize             = " << hdr.BufferSize                << "\n";

    // --- Device fields ---
    DeviceClass& dev = probeResponse.HasDevice;
    dev.Name              = "CNC_Machine_1";
    dev.Uuid              = "00000000-0000-0000-0000-000000000001";
    dev.MtconnectVersion  = std::string(DeviceClass::NORMATIVE_VERSION);

    std::cout << "  DeviceClass::NAME             = " << DeviceClass::NAME             << "\n";
    std::cout << "  DeviceClass::NORMATIVE_VERSION = " << DeviceClass::NORMATIVE_VERSION << "\n";
    std::cout << "  device.Name                   = " << dev.Name                     << "\n";
    std::cout << "  device.Uuid                   = " << dev.Uuid                     << "\n";

    // --- DataItem descriptor for X-axis position ---
    DataItemClass posX;
    posX.Id             = "pos_x";
    posX.Name           = "Xabs";
    posX.Category       = CategoryEnum::SAMPLE;          // continuously variable
    posX.Representation = RepresentationEnum::VALUE;     // single scalar per report
    posX.Units          = UnitEnum::MILLIMETER;
    posX.SampleRate     = 100.0f;                        // 100 Hz
    posX.Discrete       = false;

    std::cout << "  DataItemClass::NAME                    = " << DataItemClass::NAME << "\n";
    std::cout << "  posX.Category                          = " << to_string(posX.Category)       << "\n";
    std::cout << "  posX.Representation                    = " << to_string(posX.Representation) << "\n";
    std::cout << "  posX.Units                             = " << to_string(posX.Units)          << "\n";
    std::cout << "  posX.SampleRate                        = " << posX.SampleRate << " Hz\n";

    // --- CategoryEnum metadata ---
    std::cout << "  CategoryEnumMeta::NORMATIVE_VERSION    = "
              << CategoryEnumMeta::NORMATIVE_VERSION << "\n";

    // --- All three CategoryEnum values ---
    std::cout << "  CategoryEnum::SAMPLE    = " << to_string(CategoryEnum::SAMPLE)    << "\n";
    std::cout << "  CategoryEnum::EVENT     = " << to_string(CategoryEnum::EVENT)     << "\n";
    std::cout << "  CategoryEnum::CONDITION = " << to_string(CategoryEnum::CONDITION) << "\n";

    std::cout << "  [body: " << body.size() << " bytes]\n";
}

// ---------------------------------------------------------------------------
// sample()
//
// MTConnect Sample (snapshot) operation — GET /sample?from=<seq>&count=<n>
//
// Returns an MTConnectStreams Response Document containing up to <count>
// observations starting at sequence number <from>.
//
// Types demonstrated:
//   MTConnectStreamsClass   — root of the sample/stream response
//   HeaderClass             — sequence numbers: firstSequence, lastSequence, nextSequence
//   QueryParameterEnum      — FROM, COUNT used to build the URL query string
//   DataItemClass           — observation descriptor for SAMPLE / EVENT / CONDITION
//   RepresentationEnum      — VALUE | TIME_SERIES | DATA_SET | TABLE
//   FilterEnum              — MINIMUM_DELTA | PERIOD
//   StatisticEnum           — statistical reduction applied to samples
//   NativeUnitEnum          — native engineering unit before conversion
//   RepresentationEnumMeta, FilterEnumMeta — version metadata structs
// ---------------------------------------------------------------------------
void sample(net::io_context& ioc,
            std::string_view host,
            std::string_view port,
            uint64_t from_seq = 1,
            uint32_t count    = 100)
{
    std::cout << "\n=== SAMPLE ===\n";

    // Build query string — to_string(QueryParameterEnum::FROM) -> "from", etc.
    std::string query = build_query({
        { QueryParameterEnum::FROM,  std::to_string(from_seq) },
        { QueryParameterEnum::COUNT, std::to_string(count)    }
    });
    std::string target = "/sample" + query;
    std::cout << "  GET " << target << "\n";

    std::string body;
    try {
        body = http_get(ioc, host, port, target);
    } catch (std::exception const& ex) {
        std::cerr << "  sample(): " << ex.what() << "\n";
        return;
    }

    // --- Response document root ---
    MTConnectStreamsClass streamsResponse;
    // streamsResponse.HasHeader      — HeaderClass (sequence tracking)
    // streamsResponse.HasDeviceStream — DeviceStreamClass (observations grouped by device)

    std::cout << "  MTConnectStreamsClass::NAME             = " << MTConnectStreamsClass::NAME             << "\n";
    std::cout << "  MTConnectStreamsClass::NORMATIVE_VERSION = " << MTConnectStreamsClass::NORMATIVE_VERSION << "\n";

    // --- Header sequence numbers ---
    HeaderClass& hdr = streamsResponse.HasHeader;
    hdr.FirstSequence = from_seq;
    hdr.LastSequence  = from_seq + count - 1;
    hdr.NextSequence  = from_seq + count;

    std::cout << "  header.FirstSequence           = " << hdr.FirstSequence << "\n";
    std::cout << "  header.LastSequence            = " << hdr.LastSequence  << "\n";
    std::cout << "  header.NextSequence            = " << hdr.NextSequence  << "\n";

    // --- Three category examples ---
    // SAMPLE — spindle speed (continuously variable analog)
    DataItemClass spindle;
    spindle.Category       = CategoryEnum::SAMPLE;
    spindle.Units          = UnitEnum::REVOLUTION_PER_MINUTE;
    spindle.NativeUnits    = NativeUnitEnum::REVOLUTION_PER_MINUTE;
    spindle.SampleRate     = 10.0f;
    spindle.Representation = RepresentationEnum::VALUE;
    spindle.Discrete       = false;

    // EVENT — availability (discrete state change)
    DataItemClass avail;
    avail.Category       = CategoryEnum::EVENT;
    avail.Representation = RepresentationEnum::VALUE;

    // CONDITION — hardware fault (health / fault state)
    DataItemClass fault;
    fault.Category       = CategoryEnum::CONDITION;
    fault.Representation = RepresentationEnum::VALUE;

    std::cout << "  spindle.Category               = " << to_string(spindle.Category) << "\n";
    std::cout << "  spindle.Units                  = " << to_string(spindle.Units)    << "\n";
    std::cout << "  spindle.Representation         = " << to_string(spindle.Representation) << "\n";
    std::cout << "  avail.Category                 = " << to_string(avail.Category)  << "\n";
    std::cout << "  fault.Category                 = " << to_string(fault.Category)  << "\n";

    // --- RepresentationEnum variants ---
    std::cout << "  RepresentationEnum::VALUE       = " << to_string(RepresentationEnum::VALUE)       << "\n";
    std::cout << "  RepresentationEnum::TIME_SERIES = " << to_string(RepresentationEnum::TIME_SERIES) << "\n";
    std::cout << "  RepresentationEnum::DATA_SET    = " << to_string(RepresentationEnum::DATA_SET)    << "\n";
    std::cout << "  RepresentationEnum::TABLE       = " << to_string(RepresentationEnum::TABLE)       << "\n";
    std::cout << "  RepresentationEnumMeta::NORMATIVE_VERSION = "
              << RepresentationEnumMeta::NORMATIVE_VERSION << "\n";

    // --- FilterEnum — server-side data reduction ---
    std::cout << "  FilterEnum::MINIMUM_DELTA       = " << to_string(FilterEnum::MINIMUM_DELTA) << "\n";
    std::cout << "  FilterEnum::PERIOD              = " << to_string(FilterEnum::PERIOD)        << "\n";
    std::cout << "  FilterEnumMeta::NORMATIVE_VERSION = "
              << FilterEnumMeta::NORMATIVE_VERSION << "\n";

    std::cout << "  [body: " << body.size() << " bytes]\n";
}

// ---------------------------------------------------------------------------
// StreamingSession
//
// Async Boost.Beast client for the MTConnect Streaming operation:
//   GET /sample?interval=<ms>&heartbeat=<ms>
//
// The MTConnect agent holds the connection open and pushes new
// MTConnectStreams documents (multipart/x-mixed-replace or chunked) at the
// specified interval.  The heartbeat keeps the TCP connection alive when no
// data has changed.
//
// Types demonstrated:
//   QueryParameterEnum::INTERVAL / HEARTBEAT — URL query parameter names
//   QueryParameterEnumMeta — normative version of this enum
//   MTConnectStreamsClass   — type that each received chunk would parse into
//   HeaderClass             — tracks InstanceId to detect buffer resets
// ---------------------------------------------------------------------------
class StreamingSession : public std::enable_shared_from_this<StreamingSession>
{
public:
    explicit StreamingSession(net::io_context& ioc)
        : resolver_(net::make_strand(ioc))
        , stream_(net::make_strand(ioc))
    {}

    void run(std::string  host,
             std::string  port,
             uint32_t     interval_ms  = 1000,
             uint32_t     heartbeat_ms = 10000,
             uint32_t     max_chunks   = 5)
    {
        host_       = std::move(host);
        port_       = std::move(port);
        max_chunks_ = max_chunks;

        // Build streaming URL using QueryParameterEnum::INTERVAL / HEARTBEAT.
        // to_string() returns "interval" and "heartbeat" — the canonical
        // lowercase names defined by the MTConnect standard (normative v2.6).
        target_ = "/sample" + build_query({
            { QueryParameterEnum::INTERVAL,  std::to_string(interval_ms)  },
            { QueryParameterEnum::HEARTBEAT, std::to_string(heartbeat_ms) }
        });

        std::cout << "\n=== STREAMING ===\n";
        std::cout << "  GET " << target_ << "\n";
        std::cout << "  QueryParameterEnum::INTERVAL          = \""
                  << to_string(QueryParameterEnum::INTERVAL)  << "\"\n";
        std::cout << "  QueryParameterEnum::HEARTBEAT         = \""
                  << to_string(QueryParameterEnum::HEARTBEAT) << "\"\n";
        std::cout << "  QueryParameterEnumMeta::NORMATIVE_VERSION = "
                  << QueryParameterEnumMeta::NORMATIVE_VERSION << "\n";

        resolver_.async_resolve(
            host_, port_,
            beast::bind_front_handler(&StreamingSession::on_resolve,
                                      shared_from_this()));
    }

private:
    tcp::resolver                            resolver_;
    beast::tcp_stream                        stream_;
    beast::flat_buffer                       buffer_;
    http::request<http::empty_body>          req_;
    http::response_parser<http::string_body> parser_;
    std::string                              host_;
    std::string                              port_;
    std::string                              target_;
    uint64_t                                 chunk_count_{0};
    uint32_t                                 max_chunks_{5};

    void on_resolve(beast::error_code              ec,
                    tcp::resolver::results_type    results)
    {
        if (ec) return fail(ec, "resolve");
        stream_.async_connect(
            results,
            beast::bind_front_handler(&StreamingSession::on_connect,
                                      shared_from_this()));
    }

    void on_connect(beast::error_code                           ec,
                    tcp::resolver::results_type::endpoint_type  /*ep*/)
    {
        if (ec) return fail(ec, "connect");

        req_ = {};
        req_.method(http::verb::get);
        req_.target(target_);
        req_.version(11);
        req_.set(http::field::host, host_);
        req_.set(http::field::user_agent, BOOST_BEAST_VERSION_STRING);
        // MTConnect streaming responses use multipart/x-mixed-replace or
        // chunked transfer encoding; accept both.
        req_.set(http::field::accept, "multipart/x-mixed-replace, application/xml");

        http::async_write(
            stream_, req_,
            beast::bind_front_handler(&StreamingSession::on_write,
                                      shared_from_this()));
    }

    void on_write(beast::error_code ec, std::size_t /*bytes_transferred*/)
    {
        if (ec) return fail(ec, "write");
        // Unlimited body — the stream runs indefinitely until we close it.
        parser_.body_limit(std::numeric_limits<std::uint64_t>::max());
        do_read();
    }

    void do_read()
    {
        http::async_read_some(
            stream_, buffer_, parser_,
            beast::bind_front_handler(&StreamingSession::on_read,
                                      shared_from_this()));
    }

    void on_read(beast::error_code ec, std::size_t bytes_transferred)
    {
        if (ec == http::error::end_of_stream) {
            std::cout << "  Server closed the streaming connection.\n";
            beast::error_code sec;
            stream_.socket().shutdown(tcp::socket::shutdown_both, sec);
            return;
        }
        if (ec) return fail(ec, "read");

        ++chunk_count_;

        // ----------------------------------------------------------------
        // Each chunk is (or contains) a complete MTConnectStreams document.
        // In production: parse the XML into MTConnectStreamsClass and then
        // navigate the typed observation tree:
        //
        //   MTConnectStreamsClass chunk;          // populated by XML parser
        //   HeaderClass& hdr = chunk.HasHeader;
        //   if (hdr.InstanceId != last_instance_id) {
        //       // Buffer was reset — resync from hdr.FirstSequence
        //   }
        //   last_instance_id = hdr.InstanceId;
        //   next_seq = hdr.NextSequence;
        //
        //   DeviceStreamClass& ds = chunk.HasDeviceStream;
        //   // iterate ds.HasComponentStream -> observations by CategoryEnum
        // ----------------------------------------------------------------
        MTConnectStreamsClass chunk;
        (void)chunk; // avoid unused-variable warning in this stub

        std::cout << "  [chunk " << chunk_count_ << "] "
                  << bytes_transferred << " bytes received\n";

        if (chunk_count_ >= max_chunks_) {
            std::cout << "  Demo limit reached (" << max_chunks_
                      << " chunks). Closing connection.\n";
            beast::error_code sec;
            stream_.socket().shutdown(tcp::socket::shutdown_both, sec);
            return;
        }

        do_read();
    }

    void fail(beast::error_code ec, char const* what)
    {
        std::cerr << "  StreamingSession::" << what << ": " << ec.message() << "\n";
    }
};

// ---------------------------------------------------------------------------
// main()
// ---------------------------------------------------------------------------
int main(int argc, char* argv[])
{
    const std::string host = (argc > 1) ? argv[1] : "localhost";
    const std::string port = (argc > 2) ? argv[2] : "5000";

    std::cout << "MTConnect C++ Example Client\n";
    std::cout << "Generated by MtconnectTranspiler.Sinks.Cpp {{ version }}\n";
    std::cout << "Agent: " << host << ":" << port << "\n";

    // -----------------------------------------------------------------------
    // Static constexpr metadata — every generated type carries these:
    //   NAME, REFERENCE_ID, NORMATIVE_VERSION, DEPRECATED_VERSION, HELP_URL
    // -----------------------------------------------------------------------
    std::cout << "\n--- Generated Library Metadata ---\n";
    std::cout << "MTConnectDevicesClass::NAME              = " << MTConnectDevicesClass::NAME              << "\n";
    std::cout << "MTConnectDevicesClass::NORMATIVE_VERSION  = " << MTConnectDevicesClass::NORMATIVE_VERSION  << "\n";
    std::cout << "MTConnectStreamsClass::NAME               = " << MTConnectStreamsClass::NAME               << "\n";
    std::cout << "MTConnectStreamsClass::NORMATIVE_VERSION   = " << MTConnectStreamsClass::NORMATIVE_VERSION   << "\n";
    std::cout << "DeviceClass::NAME                        = " << DeviceClass::NAME                        << "\n";
    std::cout << "DeviceClass::NORMATIVE_VERSION            = " << DeviceClass::NORMATIVE_VERSION            << "\n";
    std::cout << "DataItemClass::NAME                      = " << DataItemClass::NAME                      << "\n";
    std::cout << "DataItemClass::NORMATIVE_VERSION          = " << DataItemClass::NORMATIVE_VERSION          << "\n";

    // ErrorCodeEnum was deprecated in MTConnect 2.6 — demonstrate DEPRECATED_VERSION
    std::cout << "ErrorCodeEnumMeta::NORMATIVE_VERSION      = " << ErrorCodeEnumMeta::NORMATIVE_VERSION     << "\n";
    std::cout << "ErrorCodeEnumMeta::DEPRECATED_VERSION     = " << ErrorCodeEnumMeta::DEPRECATED_VERSION    << "\n";
    // Example values (all deprecated since 2.6; prefer structured error classes)
    std::cout << "ErrorCodeEnum::OUT_OF_RANGE              = " << to_string(ErrorCodeEnum::OUT_OF_RANGE)   << "\n";
    std::cout << "ErrorCodeEnum::TOO_MANY                  = " << to_string(ErrorCodeEnum::TOO_MANY)       << "\n";

    // Round-trip through from_string() / to_string()
    auto cat = CategoryEnum_from_string("SAMPLE");
    std::cout << "CategoryEnum round-trip \"SAMPLE\"          = " << to_string(cat) << "\n";

    auto rep = RepresentationEnum_from_string("TIME_SERIES");
    std::cout << "RepresentationEnum round-trip \"TIME_SERIES\" = " << to_string(rep) << "\n";

    auto qp = QueryParameterEnum_from_string("interval");
    std::cout << "QueryParameterEnum round-trip \"interval\"   = " << to_string(qp) << "\n";

    try {
        // --- 1. Probe ---
        {
            net::io_context ioc;
            probe(ioc, host, port);
        }

        // --- 2. Sample (snapshot) ---
        {
            net::io_context ioc;
            sample(ioc, host, port, /*from=*/1, /*count=*/100);
        }

        // --- 3. Streaming (async, stops after 5 chunks) ---
        {
            net::io_context ioc;
            auto session = std::make_shared<StreamingSession>(ioc);
            session->run(host, port,
                         /*interval_ms=*/1000,
                         /*heartbeat_ms=*/10000,
                         /*max_chunks=*/5);
            ioc.run();
        }

    } catch (std::exception const& ex) {
        std::cerr << "Fatal: " << ex.what() << "\n";
        return EXIT_FAILURE;
    }

    std::cout << "\nDone.\n";
    return EXIT_SUCCESS;
}

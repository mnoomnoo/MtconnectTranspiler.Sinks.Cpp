namespace beast = boost::beast;
namespace http  = boost::beast::http;
namespace net   = boost::asio;
using     tcp   = boost::asio::ip::tcp;

// ---------------------------------------------------------------------------
// Type aliases — shorten the fully-qualified MTConnect namespace paths
// ---------------------------------------------------------------------------

// Protocol response document root types
using MTConnectDevicesClass =
    mtconnect::Fundamentals::MTConnectProtocol::MTConnectDevicesResponseDocument::MTConnectDevicesClass;
using MTConnectStreamsClass =
    mtconnect::Fundamentals::MTConnectProtocol::MTConnectStreamsResponseDocument::MTConnectStreamsClass;
using HeaderClass =
    mtconnect::Fundamentals::MTConnectProtocol::MTConnectErrorsResponseDocument::HeaderClass;

// Device information model
using DeviceClass   = mtconnect::DeviceInformationModel::DeviceClass;
using DataItemClass = mtconnect::DeviceInformationModel::DataItems::DataItemClass;

// DataTypes enums — all live in mtconnect::DataTypes
using mtconnect::DataTypes::CategoryEnum;
using mtconnect::DataTypes::RepresentationEnum;
using mtconnect::DataTypes::FilterEnum;
using mtconnect::DataTypes::QueryParameterEnum;
using mtconnect::DataTypes::UnitEnum;
using mtconnect::DataTypes::NativeUnitEnum;

# Generated by MtconnectTranspiler.Sinks.Cpp {{ version }}
cmake_minimum_required(VERSION 3.15)
project(mtconnect_cpp VERSION 1.0.0 LANGUAGES CXX)

# Header-only interface library — no compilation required
add_library(mtconnect_cpp INTERFACE)
add_library(mtconnect_cpp::mtconnect_cpp ALIAS mtconnect_cpp)

target_include_directories(mtconnect_cpp INTERFACE
    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>
    $<INSTALL_INTERFACE:include>
)

# Require C++17 for std::string_view and std::optional
target_compile_features(mtconnect_cpp INTERFACE cxx_std_17)

# Install rules
install(TARGETS mtconnect_cpp EXPORT mtconnect_cppTargets)
install(DIRECTORY include/ DESTINATION include)
install(EXPORT mtconnect_cppTargets
    FILE mtconnect_cppTargets.cmake
    NAMESPACE mtconnect_cpp::
    DESTINATION lib/cmake/mtconnect_cpp
)

include(CMakePackageConfigHelpers)
write_basic_package_version_file(
    "${CMAKE_CURRENT_BINARY_DIR}/mtconnect_cppConfigVersion.cmake"
    VERSION ${PROJECT_VERSION}
    COMPATIBILITY AnyNewerVersion
)
